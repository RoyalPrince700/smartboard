PORT=5000
MONGODB_URI=mongodb://localhost:27017/smart-board
NODE_ENV=development
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:5173

# AI Configuration
AI_PROVIDER=google
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
GOOGLE_VISION_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Educational agent (deterministic tutor — no AI API required for math)
AGENT_ENABLED=true

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=

# Comma-separated emails granted admin role on sign-in
ADMIN_EMAILS=
